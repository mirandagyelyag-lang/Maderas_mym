{
  "name": "Gasto",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "concepto": {
      "type": "string",
      "description": "Descripci\u00f3n del gasto, ej: Compra de clavos"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Insumos",
        "Combustible",
        "Sueldos",
        "Mantenimiento",
        "Otros"
      ],
      "default": "Otros"
    },
    "monto": {
      "type": "number"
    },
    "trabajador_email": {
      "type": "string"
    },
    "trabajador_nombre": {
      "type": "string"
    },
    "comentario": {
      "type": "string"
    }
  },
  "required": [
    "fecha",
    "concepto",
    "categoria",
    "monto"
  ]
}