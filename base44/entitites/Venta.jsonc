{
  "name": "Venta",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "producto_id": {
      "type": "string",
      "description": "Referencia al producto vendido"
    },
    "nombre_producto": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "cantidad": {
      "type": "number"
    },
    "precio_unitario": {
      "type": "number"
    },
    "costo_unitario": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "trabajador_email": {
      "type": "string"
    },
    "trabajador_nombre": {
      "type": "string"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta",
        "Cuenta Corriente"
      ],
      "default": "Efectivo"
    },
    "cliente": {
      "type": "string",
      "description": "Nombre del cliente (opcional)"
    }
  },
  "required": [
    "fecha",
    "nombre_producto",
    "cantidad",
    "precio_unitario",
    "total"
  ]
}