{
  "name": "Cotizacion",
  "type": "object",
  "properties": {
    "numero": {
      "type": "number",
      "description": "N\u00famero correlativo de cotizaci\u00f3n"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "cliente_id": {
      "type": "string",
      "description": "Referencia al cliente"
    },
    "nombre_cliente": {
      "type": "string"
    },
    "telefono_cliente": {
      "type": "string"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "descuento": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "validez_dias": {
      "type": "number",
      "default": 15
    },
    "estado": {
      "type": "string",
      "enum": [
        "Borrador",
        "Enviada",
        "Aceptada",
        "Rechazada"
      ],
      "default": "Borrador"
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "numero",
    "fecha",
    "nombre_cliente"
  ]
}